    m * M * ((x - y) ^ 2 * z + (x - z) ^ 2 * y + (y - z) ^ 2 * x)

def reflectedUpperNumerator (m M x y z : ℝ) : ℝ :=
  upperNumerator m M (m + M - z) (m + M - y) (m + M - x)

